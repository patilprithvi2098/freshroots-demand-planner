{
  "name": "freshroots-planner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:acceptance": "vitest run tests/acceptance.test.ts",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "invite": "tsx --env-file=.env.local scripts/invite-user.ts",
    "dev-link": "tsx --env-file=.env.local scripts/dev-login-link.ts",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "delete-user": "tsx --env-file=.env.local scripts/delete-user.ts",
    "sku-images": "tsx scripts/generate-sku-images.ts",
    "demo-reset": "tsx --conditions=react-server --env-file=.env.local scripts/demo-reset.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.61.0",
    "next": "15.5.28",
    "papaparse": "^5.7.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
