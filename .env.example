# Supabase (Project settings > API). The anon/publishable key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Server only. Without it, exceptions show "Rationale unavailable" and everything else works.
ANTHROPIC_API_KEY=
# Monthly Claude spend cap in USD. When reached, runs continue without rationales.
AI_MONTHLY_SPEND_CAP_USD=20
MAX_RUNS_PER_DAY=10
# Vercel Cron sends this as a Bearer token to /api/cron/run.
CRON_SECRET=
# Base URL used in magic-link redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
